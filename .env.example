# ---- AU Cupboards 环境变量示例 ----
# 复制为 .env 后按需修改。.env 已被 .gitignore 排除，不会入库。

# 数据库（默认 SQLite，路径相对 backend/var/）
AUCUP_DB=sqlite:///./aucup.db

# 上传与导出目录
AUCUP_UPLOAD_DIR=./var/uploads
AUCUP_EXPORT_DIR=./var/export

# DWG 解析后端优先级（默认 oda -> libredwg）
# 生产环境强烈建议安装 ODA File Converter（免费注册）：
#   https://www.opendesign.com/guestfiles/oda_file_converter
# 仅测试环境可用 LibreDWG 兜底（GPLv3，高版本 DWG 支持不全）：
#   https://ftp.gnu.org/gnu/libredwg/
AUCUP_DWG_BACKEND=auto

# 解析规则配置（改配置即改行为，无需改代码）
AUCUP_PARSE_RULES=app/config/parse_rules.json

# ---- AI（默认关闭）----
# 仅当扫描件无文本层时使用，且强制人工确认。
# 不配置即完全走矢量文本层，不产生任何 AI 调用。
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
